# Entorno local (nunca versionar credenciales reales)
# Copiar a .env y completar con valores locales de desarrollo.
PORT=3000
NODE_ENV=development

# Secreto JWT: mínimo 32 bytes en producción. Nunca versionar el valor real.
# En desarrollo, si falta, se usa únicamente un valor por defecto con advertencia.
# JWT_SECRET=

# PostgreSQL local (Prisma Migrate). Solo desarrollo; nunca versionar credenciales reales.
DATABASE_URL="postgresql://merkee:merkee@localhost:5433/merkee_shop?schema=public"

# Bootstrap seguro del admin inicial (ADR-010). La contraseña SOLO llega por
# referencia externa (variable de entorno no versionada o Secrets Manager vía
# task role). Nunca versionar un valor real. Si falta, el bootstrap falla de
# forma segura sin crear usuario.
# INITIAL_ADMIN_PASSWORD=

# Habilita/deshabilita el bootstrap del admin inicial al arrancar (default true).
# BOOTSTRAP_INITIAL_ADMIN_ENABLED=true
